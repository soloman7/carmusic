<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 约束：网络电台直播流 host 极度分散且大量为 http（公开广播），
         Android NSC 无法按「仅播放器路径」放行明文，base 关死会打断电台功能。
         因此 base 维持明文；音乐 API/更新链路靠代码强制 https（UpdateManager /
         ProviderHttp），并在 domain-config 里显式记录音乐 CDN 的明文例外。 -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- 咪咕播放/封面 CDN -->
        <domain includeSubdomains="true">migu.cn</domain>
        <!-- 酷我 antiserver 流地址 -->
        <domain includeSubdomains="true">kuwo.cn</domain>
        <!-- 网易云流 CDN（m701.music.126.net 等） -->
        <domain includeSubdomains="true">126.net</domain>
        <!-- 酷狗流 CDN -->
        <domain includeSubdomains="true">kugou.com</domain>
        <!-- 猫耳音频 CDN -->
        <domain includeSubdomains="true">missevan.com</domain>
    </domain-config>
</network-security-config>
